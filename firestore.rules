rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function professor() { return logado() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function donoDaAula(id) {
      return logado() && get(/databases/$(database)/documents/aulas/$(id)).data.profUid == request.auth.uid;
    }

    // Disciplina: o aluno lê (nome, turma e plano de ensino) quando abre uma aula. Só o dono lista e altera.
    match /disciplinas/{id} {
      allow get: if logado();
      allow list: if professor() && resource.data.profUid == request.auth.uid;
      allow create: if professor() && request.resource.data.profUid == request.auth.uid;
      allow update, delete: if professor() && resource.data.profUid == request.auth.uid;
    }

    // Aula: o aluno abre pelo código. Só o dono lista e altera.
    match /aulas/{id} {
      allow get: if logado();
      allow list: if professor() && resource.data.profUid == request.auth.uid;
      allow create: if professor() && request.resource.data.profUid == request.auth.uid;
      allow update, delete: if professor() && resource.data.profUid == request.auth.uid;

      match /sessoes/{uid} {
        // Cada aluno lê e escreve só a própria sessão. O professor dono da aula lê todas.
        allow get, create, update: if logado() && request.auth.uid == uid;
        allow read, delete: if donoDaAula(id);
      }
    }
  }
}
